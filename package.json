{
  "name": "solaryna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev -w @solaryna/bot",
    "dev:web": "npm run dev -w @solaryna/web",
    "build:web": "npm run build -w @solaryna/web",
    "start:web": "npm run start -w @solaryna/web",
    "db:create": "npm run create -w @solaryna/db",
    "db:generate": "npm run generate -w @solaryna/db",
    "db:migrate": "npm run migrate -w @solaryna/db",
    "wallets:import": "tsx scripts/import-wallets.ts",
    "fixture:fetch": "tsx scripts/fetch-tx-fixture.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
