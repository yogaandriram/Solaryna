# Salin ke .env lalu isi sendiri. Jangan pernah commit .env.
# Nilai kosong dianggap "tidak diisi"; kunci tanpa nilai default wajib diisi.

# ── Umum ─────────────────────────────────────────────────────────────
NODE_ENV=development
TZ_DISPLAY=Asia/Jakarta
DATABASE_URL=mysql://root:@127.0.0.1:3306/solaryna

# ── Data on-chain ────────────────────────────────────────────────────
HELIUS_API_KEY=
# RPC Helius (bukan RPC publik), mis. https://mainnet.helius-rpc.com/?api-key=...
# URL ini berisi API key: rahasiakan.
SOLANA_RPC_URL=
# webhook | websocket (websocket tidak butuh URL publik, cocok untuk development)
INGEST_SOURCE=webhook
# Dua kunci berikut wajib jika INGEST_SOURCE=webhook (lihat README: "Webhook Helius").
# ID webhook bertipe raw yang Anda buat di dashboard Helius.
HELIUS_WEBHOOK_ID=
# Rahasia acak minimal 16 karakter; bot memasangnya sebagai authHeader webhook dan menolak
# request yang header Authorization-nya tidak sama.
HELIUS_WEBHOOK_SECRET=
# Alamat server penerima webhook. Path-nya /webhooks/helius.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787
BIRDEYE_API_KEY=

# ── Jupiter (key dari portal.jup.ag) ─────────────────────────────────
JUPITER_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Chat id yang boleh memberi perintah, pisahkan dengan koma.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Dashboard ────────────────────────────────────────────────────────
# Wajib, minimal 12 karakter. Dashboard menolak start jika kosong.
DASHBOARD_PASSWORD=

# ── Mode trading ─────────────────────────────────────────────────────
# paper | live. Live hanya aktif jika TRADING_MODE=live, LIVE_TRADING_ACKNOWLEDGED=true,
# dan BOT_WALLET_PRIVATE_KEY valid. Selain itu bot jalan sebagai paper.
TRADING_MODE=paper
LIVE_TRADING_ACKNOWLEDGED=false
# Hanya untuk live. Base58. Pakai hot wallet KHUSUS bot berisi modal kecil, bukan wallet utama.
BOT_WALLET_PRIVATE_KEY=

# ── Batas risiko (berlaku di paper & live) ───────────────────────────
MAX_SOL_PER_TRADE=0.05
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT_SOL=0.2
MIN_LIQUIDITY_USD=20000
MAX_SLIPPAGE_BPS=300
MAX_PRIORITY_FEE_LAMPORTS=200000
# Jeda yang disimulasikan di paper trading.
COPY_DELAY_MS=3000
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=30
MAX_HOLD_MINUTES=240
# Sinyal beli lebih tua dari ini (detik sejak swap wallet) ditolak.
MAX_SIGNAL_AGE_SECONDS=30
